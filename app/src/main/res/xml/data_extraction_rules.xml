<?xml version="1.0" encoding="utf-8"?>
<!-- API keys are bound to this device's Keystore and cannot be restored elsewhere; nothing is backed up.
     Recipes can be exported/imported as JSON from the app instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
